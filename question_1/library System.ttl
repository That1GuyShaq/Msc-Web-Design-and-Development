@base <http://m9aii.org/> .
@prefix ex: <http://m9aii.org/question_1#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Define Classes
    ex:LibraryResource a rdfs:Class .
    ex:Book a rdfs:Class ; rdfs:subClassOf ex:LibraryResource .
    ex:Author a rdfs:Class .
    ex:Publisher a rdfs:Class .
    ex:Copy a rdfs:Class .

# Define Properties
    ex:hasAuthor a rdf:Property ;
        rdfs:domain ex:Book ;
        rdfs:range ex:Author .

    ex:publishedBy a rdf:Property ;
        rdfs:domain ex:Book ;
        rdfs:range ex:Publisher .

    ex:publicationYear a rdf:Property ;
        rdfs:domain ex:Book ;
        rdfs:range rdfs:Literal .

# Instances of Authors
    ex:J.K.Rowling a ex:Author .
    ex:George.Orwell a ex:Author .

# Instances of Publishers
    ex:PenguinBooks a ex:Publisher .
    ex:Bloomsbury a ex:Publisher .

# Instances of Books
    ex:HarryPotter a ex:Book ;
        ex:hasAuthor ex:J.K.Rowling ;
        ex:publishedBy ex:Bloomsbury ;
        ex:publicationYear "1997" .

    ex:1984 a ex:Book ;
        ex:hasAuthor ex:George.Orwell ;
        ex:publishedBy ex:PenguinBooks ;
        ex:publicationYear "1949" .